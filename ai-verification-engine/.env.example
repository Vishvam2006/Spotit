# Groq API Configuration
# Get a key at https://console.groq.com/keys — never commit a real one.
GROQ_API_KEY=gsk_your_key_here

# Text model: OCR-text classification and field extraction.
GROQ_MODEL=openai/gpt-oss-20b

# Vision models for document image analysis, tried in order.
# GROQ_MODEL above is text-only and cannot accept image input.
# Groq's catalog varies per account and a wrong id fails with a 404 that is easy
# to miss. Check what your key can reach before changing this:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | python3 -m json.tool
GROQ_VISION_MODELS=qwen/qwen3.6-27b

# Shared secret required by the engine's X-API-Key middleware.
# Must match AI_ENGINE_API_KEY in backend/.env, or the engine is unauthenticated.
AI_ENGINE_API_KEY=change_me_shared_secret

# Comma-separated browser origins allowed by CORS.
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-request Groq timeout, and the total wall-clock budget for one
# /verify-documents call (kept under the Node client's abort).
AI_REQUEST_TIMEOUT_S=25
AI_TOTAL_BUDGET_S=75

# Normalization & Matching Configuration
NAME_MATCH_THRESHOLD=0.90
