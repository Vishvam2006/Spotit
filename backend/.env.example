# Server port (must match VITE_API_PORT in frontend/.env)
PORT=5001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/spotit

# JWT configuration
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-random-32+-char-secret
JWT_EXPIRES_IN=7d

# Initial Admin account created by `npm run prisma:seed`
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin@12345
# ADMIN_NAME=Spotit Admin

# Frontend URL for CORS and redirects (comma-separated for multiple origins)
WEB_APP_URL=http://localhost:5173

# Comma-separated list of allowed browser origins (CORS)
# CORS_ORIGINS=http://localhost:5173,https://app.spotit.example

# AI Verification Engine (Python FastAPI service)
# When AI_ENGINE_API_KEY is set, it is sent as the X-API-Key header and the
# engine refuses requests without the matching key.
# AI_ENGINE_API_KEY=replace-with-a-shared-secret
# AI_VERIFICATION_URL=http://127.0.0.1:8000/verify-documents
# How long to wait for the engine. Sits above the engine's own AI_TOTAL_BUDGET_S
# (75s) so it can return a partial answer before we give up.
# AI_ENGINE_TIMEOUT_MS=90000
# The bridge fallback runs a different pipeline and cannot OCR images without a
# local OCR engine installed, so it returns confident rejections for valid
# documents. Off by default: an unreachable engine reports "not checked" instead.
# VERIFICATION_BRIDGE_FALLBACK=false

# Account lockout / brute-force protection
# AUTH_RATE_LIMIT_MAX=20

# Document upload limits (bytes)
# MAX_UPLOAD_TOTAL_BYTES=26214400
# MAX_UPLOAD_FILE_BYTES=15728640

# Geofencing and session reliability
GEOFENCE_ENABLED=true

# DEMO_MODE skips the geofence check on check-in and check-out.
#
# Set this to true when demoing on a laptop or any machine without usable GPS:
# without it, check-in fails because the browser cannot prove the driver is
# standing at the lot. It changes nothing else -- bookings, reports, disputes
# and lot scoring all behave normally.
#
# Never enable it in production: it is the only thing stopping a driver from
# checking in to a lot they are nowhere near.
DEMO_MODE=false
CHECKIN_RADIUS_METERS=80
CHECKOUT_RADIUS_METERS=150
MAX_ACCURACY_METERS=35
LOCATION_MAX_AGE_SECONDS=45
MIN_CHECKIN_READINGS=2
MIN_DWELL_SECONDS=30
REQUIRED_OUTSIDE_READINGS=3
CHECKOUT_GRACE_SECONDS=180
MAX_SPEED_MPS=30
HEARTBEAT_INTERVAL_SECONDS=30
SESSION_STALE_SECONDS=120
# Background sweeper that auto-expires reservations and completes ended sessions
SESSION_SWEEP_INTERVAL_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Cloudinary (parking lot photos + vehicle images)
CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=
CLOUDINARY_PARKING_FOLDER=spotit/parking-lots
CLOUDINARY_VEHICLE_FOLDER=spotit/vehicles

# Password hashing cost factor (4-15). Ignored in production, which always
# uses 10 — lower it only for test runs, where bcrypt otherwise dominates.
# BCRYPT_ROUNDS=10

# How many open SERIOUS reports pull a lot out of circulation (UNDER_REVIEW).
# Defaults to 2, which is what the engine is specified and tested against.
# Lower it to 1 to demonstrate escalation with a single report.
# UNDER_REVIEW_THRESHOLD=2

# Rate limit for filing a direct lot report (no booking required). Filing is a
# privileged act -- reports pull lots from search -- so this is deliberately
# tighter than the general booking limiter.
# REPORT_RATE_LIMIT_MAX=10
# REPORT_RATE_LIMIT_WINDOW_MS=3600000

# SMTP/Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-company-email@example.com
SMTP_PASS=your-email-password-or-app-password
EMAIL_FROM=\
Spotit
Support\ <noreply@spotit.example>

# Razorpay payment gateway (test mode for demos)
# Sign up at https://dashboard.razorpay.com and grab keys from Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
