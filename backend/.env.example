# Server port (must match VITE_API_PORT in frontend/.env)
PORT=5002

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/parkmitra

# JWT configuration
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Geofencing and session reliability
GEOFENCE_ENABLED=true
DEMO_MODE=false
CHECKIN_RADIUS_METERS=120
CHECKOUT_RADIUS_METERS=200
MAX_ACCURACY_METERS=50
LOCATION_MAX_AGE_SECONDS=60
MIN_CHECKIN_READINGS=2
MIN_DWELL_SECONDS=30
REQUIRED_OUTSIDE_READINGS=3
CHECKOUT_GRACE_SECONDS=180
MAX_SPEED_MPS=30
HEARTBEAT_INTERVAL_SECONDS=30
SESSION_STALE_SECONDS=120
# Background sweeper that auto-expires reservations and completes ended sessions
SESSION_SWEEP_INTERVAL_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Cloudinary (parking lot photos + vehicle images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
