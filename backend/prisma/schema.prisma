generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  passwordHash String
  phone        String?
  profileImage String?
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ParkingLot   ParkingLot[]
  Booking      Booking[]
  vehicles     Vehicle[]
  verifications VerificationRequest[]
  complaints   Complaint[]
}

model ParkingLot {
  id              String           @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  address         String
  city            String
  latitude        Float
  longitude       Float
  pricePerHour    Float
  totalSpaces     Int
  availableSpaces Int
  status          ParkingLotStatus @default(ACTIVE)
  imageUrl        String?
  photos          String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Booking         Booking[]
  complaints      Complaint[]

  @@index([ownerId])
  @@index([city])
  @@index([status])
}

enum BookingStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
}

model Vehicle {
  id            String      @id @default(cuid())
  userId        String
  registration  String
  type          VehicleType
  imageUrl      String
  imagePublicId String
  make          String?
  model         String?
  color         String?
  isDefault     Boolean     @default(false)
  // Latest AI document-verification outcome for this vehicle:
  // null = never verified, otherwise VERIFIED / NEEDS_REVIEW / REJECTED.
  verificationStatus String?
  verifiedAt         DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications VerificationRequest[]

  @@unique([userId, registration])
  @@index([userId])
  @@index([userId, isDefault])
}

model Booking {
  id                String        @id @default(cuid())
  userId            String
  parkingLotId      String
  vehicleNumber     String
  durationMinutes   Int
  reservedAt        DateTime
  checkInDeadline   DateTime
  checkInTime       DateTime?
  sessionEndsAt     DateTime?
  checkOutTime      DateTime?
  estimatedAmount   Float?
  finalAmount       Float?
  status            BookingStatus @default(RESERVED)
  cancellationReason String?
  cancelledAt        DateTime?
  lastLocationAt    DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  vehicleId         String?
  vehicleRegistration String
  vehicleType       VehicleType
  vehicleImageUrl   String
  vehicleMake       String?
  vehicleModel      String?
  vehicleColor      String?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingLot    ParkingLot      @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  locationAudit LocationAudit[]
  complaints    Complaint[]

  @@index([userId, status])
  @@index([parkingLotId, status])
  @@index([vehicleId])
  @@index([status, checkInDeadline])
  @@index([status, createdAt])
  @@index([createdAt])
}

model VerificationRequest {
  id                String   @id @default(cuid())
  userId            String
  vehicleId         String?
  overallStatus     String
  overallConfidence Float
  summary           String
  documents         Json
  createdAt         DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model LocationAudit {
  id              String   @id @default(cuid())
  bookingId       String
  eventType       String
  lat             Float?
  lng             Float?
  distanceMeters  Float?
  accuracyMeters  Float?
  capturedAt      DateTime
  accepted        Boolean
  rejectionReason String?
  createdAt       DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([bookingId, eventType, accepted])
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum ComplaintStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

model Complaint {
  id           String          @id @default(cuid())
  userId       String
  parkingLotId String?
  bookingId    String?
  category     String
  subject      String
  description  String
  status       ComplaintStatus @default(PENDING)
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingLot ParkingLot? @relation(fields: [parkingLotId], references: [id], onDelete: SetNull)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([parkingLotId])
  @@index([bookingId])
  @@index([status, createdAt])
}

enum ParkingLotStatus {
  ACTIVE
  INACTIVE
  CLOSED
}
