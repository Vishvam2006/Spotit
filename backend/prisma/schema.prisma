generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  passwordHash String
  phone        String?
  profileImage String?
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ParkingLot   ParkingLot[]
}

model ParkingLot {
  id              String           @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  address         String
  city            String
  latitude        Float
  longitude       Float
  pricePerHour    Float
  totalSpaces     Int
  availableSpaces Int
  status          ParkingLotStatus @default(ACTIVE)
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  User            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([status])
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum ParkingLotStatus {
  ACTIVE
  INACTIVE
  CLOSED
}
