generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  passwordHash String
  phone        String?
  profileImage String?
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ParkingLot   ParkingLot[]
  Booking      Booking[]
}

model ParkingLot {
  id              String           @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  address         String
  city            String
  latitude        Float
  longitude       Float
  pricePerHour    Float
  totalSpaces     Int
  availableSpaces Int
  status          ParkingLotStatus @default(ACTIVE)
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  User            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Booking         Booking[]

  @@index([city])
  @@index([status])
}

enum BookingStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  parkingLotId    String
  vehicleNumber   String
  startTime       DateTime
  reservedUntil   DateTime
  checkInTime     DateTime?
  checkOutTime    DateTime?
  estimatedAmount Float?
  finalAmount     Float?
  status          BookingStatus @default(RESERVED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingLot ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([parkingLotId, status])
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum ParkingLotStatus {
  ACTIVE
  INACTIVE
  CLOSED
}
